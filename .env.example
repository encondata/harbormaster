# Copy to .env and change every value marked CHANGE ME before the first start.

# Port the web container publishes on the host. Point your reverse proxy here.
WEB_PORT=8090

# Public URL users reach the app at (through the reverse proxy). Used for links and cookies.
PUBLIC_URL=https://kanban.example.com

# Set to false only if you reach the app over plain http (no TLS at the proxy).
COOKIE_SECURE=true

# First administrator, created on first start only if no users exist yet.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator
ADMIN_PASSWORD=CHANGE-ME-long-random-password

# Postgres
POSTGRES_DB=harbormaster
POSTGRES_USER=harbormaster
POSTGRES_PASSWORD=CHANGE-ME-postgres-password

# MinIO (S3 storage for attachments)
MINIO_ROOT_USER=harbormaster
MINIO_ROOT_PASSWORD=CHANGE-ME-minio-password
S3_BUCKET=harbormaster

# Max attachment upload size in megabytes
MAX_UPLOAD_MB=25

# Optional: Google Sheets link to import into the ServerSherpa project on first start
# (only when that project has no cards yet). The sheet must be viewable by link.
SEED_SHEET_URL=

# Proxies in front of the API: nginx in the web container plus your house reverse proxy.
# Use 1 if nothing sits in front of the web container.
TRUST_PROXY_HOPS=2

# Time zone for scheduled jobs (the daily Google Sheet export), e.g. America/Chicago.
TIMEZONE=UTC

# Folder holding google-service-account.json, mounted read-only into the API. Defaults to
# ./secrets next to docker-compose.yml. Use an absolute path outside the checkout (e.g.
# /mnt/user/appdata/harbormaster/secrets) when a deploy tool such as Slipway runs the app from
# its own release folder, or the key would not be found after a redeploy.
SECRETS_DIR=

# Optional: "Sign in with Google" (see docs/GOOGLE-SIGN-IN.md). Only people who already have an
# account can use it. ALLOWED_DOMAINS limits it to those email domains (comma-separated).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_ALLOWED_DOMAINS=

# Optional: "Sign in with HackSpaceLabs" (see docs/HSL-SIGN-IN.md). The HSL installer's
# deployment/scripts/app-env.mjs fills these in. Off unless the issuer, client id and secret are all set
# (and PUBLIC_URL, which must be the origin registered for the harbormaster client in Keycloak).
HSL_OIDC_ISSUER=
HSL_OIDC_CLIENT_ID=harbormaster
HSL_OIDC_CLIENT_SECRET=
# Optional origin for server-to-server calls to Keycloak (discovery, tokens, keys) when the API container
# can't reach the public issuer address, e.g. http://192.168.1.10:8089.
HSL_OIDC_INTERNAL_URL=
# true: signed-out visitors go straight to HackSpaceLabs (local sign-in stays at /login?local=1).
HSL_OIDC_AUTO_REDIRECT=false
# How often (seconds) a HackSpaceLabs session is rechecked with Keycloak.
HSL_OIDC_RECHECK_SECONDS=60
# The HackSpaceLabs portal, for the app switcher, e.g. https://hackspacelabs.com
HSL_PORTAL_URL=
# The portal gateway called directly (not through the proxy), e.g. http://192.168.1.10:8088. Used to check,
# at most every 5 minutes per person, that the owner of an API or Claude connector token tied to
# HackSpaceLabs is still enabled there and still has a Harbor Master role. Empty = that check is off.
HSL_PORTAL_INTERNAL_URL=
# App switcher entries: id|name|url separated by commas.
HSL_SUITE_APPS=
