# Copy to .env and change every value marked CHANGE ME before the first start.

# Port the web container publishes on the host. Point your reverse proxy here.
WEB_PORT=8090

# Public URL users reach the app at (through the reverse proxy). Used for links and cookies.
PUBLIC_URL=https://kanban.example.com

# Set to false only if you reach the app over plain http (no TLS at the proxy).
COOKIE_SECURE=true

# First administrator, created on first start only if no users exist yet.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator
ADMIN_PASSWORD=CHANGE-ME-long-random-password

# Postgres
POSTGRES_DB=harbormaster
POSTGRES_USER=harbormaster
POSTGRES_PASSWORD=CHANGE-ME-postgres-password

# MinIO (S3 storage for attachments)
MINIO_ROOT_USER=harbormaster
MINIO_ROOT_PASSWORD=CHANGE-ME-minio-password
S3_BUCKET=harbormaster

# Max attachment upload size in megabytes
MAX_UPLOAD_MB=25

# Optional: Google Sheets link to import into the ServerSherpa project on first start
# (only when that project has no cards yet). The sheet must be viewable by link.
SEED_SHEET_URL=

# Proxies in front of the API: nginx in the web container plus your house reverse proxy.
# Use 1 if nothing sits in front of the web container.
TRUST_PROXY_HOPS=2

# Time zone for scheduled jobs (the daily Google Sheet export), e.g. America/Chicago.
TIMEZONE=UTC

# Optional: "Sign in with Google" (see docs/GOOGLE-SIGN-IN.md). Only people who already have an
# account can use it. ALLOWED_DOMAINS limits it to those email domains (comma-separated).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_ALLOWED_DOMAINS=
